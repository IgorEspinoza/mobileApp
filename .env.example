# ============================================
# REQUERIDAS - La app no funciona sin estas
# ============================================

# Supabase -> Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Protege el cron de cuotas (/api/cron/installments/generate)
# Genera un valor aleatorio largo
CRON_SECRET=your-strong-random-secret


# ============================================
# OPCIONALES - Descomenta solo si las usas
# ============================================

# Monitoreo de errores (Sentry)
# NEXT_PUBLIC_SENTRY_DSN=your-sentry-dsn
# SENTRY_AUTH_TOKEN=your-sentry-token


# ============================================
# FASE 2 - Aun no implementadas, no configurar
# ============================================

# OPENAI_API_KEY=sk-your-api-key
# GOOGLE_CLIENT_ID=your-google-client-id
# GOOGLE_CLIENT_SECRET=your-google-client-secret
# GMAIL_API_KEY=your-gmail-api-key
